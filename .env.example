# =====================================================
# SUSHI SHOP DOCKER ENVIRONMENT
# =====================================================
# INSTRUCTIONS:
# 1. Copy to .env
# 2. Fill values, then: docker compose up -d
# =====================================================

# Only needed if using compose.prod.yaml (pulls prebuilt images from
# DockerHub instead of building locally). Not needed for plain compose.yaml.
DOCKERHUB_USERNAME=your_dockerhub_username

DB_HOST=localhost
DB_PORT=5433
DB_NAME=sushi_db
DB_USER=postgres
DB_PASSWORD=your_db_password_here

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET=your_jwt_secret_here

EMAIL_USERNAME=sushi.bas.shop@gmail.com
EMAIL_PASSWORD=your_app_password_here

GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_client_secret

STRIPE_SECRET_KEY=your_stripe_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

NGROK_AUTH_TOKEN=your_token_here

APP_BASE_URL=http://localhost:5173

# AI RAG phase (optional): see docs/ai-rag.md before enabling.
# No API key is needed for the local Ollama provider.
# For local bootRun use ai; for Docker backend use docker,ai.
# SPRING_PROFILES_ACTIVE=ai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
# Embedding model is pinned to nomic-embed-text (768 dimensions) in application-ai.yml.
# Optional hourly reindex; leave disabled until the first manual index succeeds.
AI_INDEXING_CRON=-

# Comma-separated IPs of proxies allowed to supply X-Forwarded-For.
# Local Vite uses 127.0.0.1. Do not put ordinary client IPs here.
RATE_LIMIT_TRUSTED_PROXIES=127.0.0.1,::1

# AWS S3 product-image storage (required)
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-sushi-shop-bucket
AWS_S3_KEY_PREFIX=products
# Optional. Use this for CloudFront, custom domain, or public S3 base URL.
AWS_S3_PUBLIC_URL=
# AWS credentials are read by the AWS SDK default provider chain.
# For local dev, set these in your shell or secret manager, not in git:
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# =====================================================
# WHERE TO GET VALUES:
# =====================================================
# DB_PASSWORD      - any password
# JWT_SECRET       - run: openssl rand -base64 32
# EMAIL_PASSWORD   - https://myaccount.google.com/apppasswords
# GOOGLE_*         - https://console.cloud.google.com/apis/credentials
# STRIPE_*         - https://dashboard.stripe.com/test/apikeys
# NGROK_AUTH_TOKEN - https://dashboard.ngrok.com/get-started/your-authtoken
# AWS_*            - AWS IAM user/role with S3 PutObject/DeleteObject permission
# =====================================================
